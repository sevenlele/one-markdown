{
  "productName": "OneMarkdown",
  "version": "0.2.0",
  "identifier": "com.onemarkdown.app",
  "build": {
    "frontendDist": "./frontend",
    "devUrl": "http://localhost:1420",
    "capabilitiesDir": "./capabilities"
  },
  "app": {
    "windows": [
      {
        "title": "OneMarkdown",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; connect-src 'self' https: wss:; img-src 'self' data:; font-src 'self' https://cdn.jsdelivr.net"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "frontend/icons/32x32.png",
      "frontend/icons/128x128.png",
      "frontend/icons/128x128@2x.png",
      "frontend/icons/icon.icns",
      "frontend/icons/icon.ico"
    ]
  }
}
