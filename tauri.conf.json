{
  "$schema": "https://raw.githubusercontent.com/nicklasxyz/tauri/tauri-v2/crates/tauri-cli/schema.json",
  "productName": "OneMarkdown",
  "version": "0.1.0",
  "identifier": "com.onemarkdown.app",
  "build": {
    "frontendDist": "./frontend",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "title": "OneMarkdown",
    "windows": [
      {
        "title": "OneMarkdown",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "frontend/icons/32x32.png",
      "frontend/icons/128x128.png",
      "frontend/icons/128x128@2x.png",
      "frontend/icons/icon.icns",
      "frontend/icons/icon.ico"
    ]
  }
}
